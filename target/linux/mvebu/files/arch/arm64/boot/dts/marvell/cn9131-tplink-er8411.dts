#include "cn9130.dtsi"

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	model = "TP-Link ER8411";
	compatible = "tplink,er8411",
		     "marvell,armada-ap807-quad", "marvell,armada-ap807";

	chosen {
		stdout-path = "serial1:115200n8";

		// The ER8411 bootloader manages dual boot partitions for recovery mode,
		// but OpenWRT only boots correctly from the primary slot. Override the
		// bootargs to ensure this is the case.
		bootargs-override = "console=ttyS1,115200 earlycon=uart8250,mmio32,0xf2702200 ubi.mtd=firmware,2048";
	};

	aliases {
		led-boot = &led_system;
		led-failsafe = &led_system;
		led-running = &led_system;
		led-upgrade = &led_system;
		gpio1 = &cp0_gpio1;
		gpio2 = &cp0_gpio2;
		gpio3 = &cp1_gpio1;
		gpio4 = &cp1_gpio2;
		i2c0 = &cp1_i2c0;
		ethernet0 = &cp0_eth0;
		ethernet1 = &cp1_eth0;
		spi1 = &cp0_spi0;
		spi2 = &cp0_spi1;
		serial1 = &cp0_uart2;
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x0 0x0 0x80000000>;
	};

	cp0_reg_usb3_vbus0: cp0_usb3_vbus@0 {
		compatible = "regulator-fixed";
		regulator-name = "cp0-xhci0-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		//gpio = <&expander0 0 GPIO_ACTIVE_HIGH>;
	};

	cp0_usb3_0_phy0: cp0_usb3_phy0 {
		compatible = "usb-nop-xceiv";
		vcc-supply = <&cp0_reg_usb3_vbus0>;
	};

	cp0_reg_usb3_vbus1: cp0_usb3_vbus@1 {
		compatible = "regulator-fixed";
		regulator-name = "cp0-xhci1-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		//gpio = <&expander0 1 GPIO_ACTIVE_HIGH>;
	};

	cp0_usb3_0_phy1: cp0_usb3_phy1 {
		compatible = "usb-nop-xceiv";
		vcc-supply = <&cp0_reg_usb3_vbus1>;
	};

	cp0_sfp_eth0: sfp-eth0 {
		compatible = "sff,sfp";
		i2c-bus = <&cp0_sfpp0_i2c>;
		los-gpios = <&cp0_module_expander1 11 GPIO_ACTIVE_HIGH>;
		mod-def0-gpios = <&cp0_module_expander1 10 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&cp0_module_expander1 9 GPIO_ACTIVE_HIGH>;
		tx-fault-gpios = <&cp0_module_expander1 8 GPIO_ACTIVE_HIGH>;
		/*
		 * SFP cages are unconnected on early PCBs because of an the I2C
		 * lanes not being connected. Prevent the port for being
		 * unusable by disabling the SFP node.
		 */
		status = "disabled";
	};

	cp1_reg_usb3_vbus0: regulator-6 {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&cp1_xhci0_vbus_pins>;
		regulator-name = "cp1-xhci0-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&cp1_gpio1 3 GPIO_ACTIVE_HIGH>;
	};

	cp1_usb3_0_phy0: usb-phy-3 {
		compatible = "usb-nop-xceiv";
		vcc-supply = <&cp1_reg_usb3_vbus0>;
	};

	cp1_reg_usb3_vbus1: cp1_usb3_vbus@1 {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&cp1_xhci1_vbus_pins>;
		regulator-name = "cp1-xhci1-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&cp1_gpio1 14 GPIO_ACTIVE_HIGH>;
	};

	cp1_usb3_0_phy1: cp1_usb3_phy1 {
		compatible = "usb-nop-xceiv";
		vcc-supply = <&cp1_reg_usb3_vbus1>;
	};

	cp1_sfp_eth0: sfp-wan {
		compatible = "sff,sfp";
		i2c-bus = <&cp1_i2c0>;
		los-gpio = <&cp1_gpio1 18 GPIO_ACTIVE_HIGH>;
		mod-def0-gpio = <&cp1_gpio1 17 GPIO_ACTIVE_LOW>;
		tx-disable-gpio = <&cp1_gpio1 16 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&cp1_sfp_pins>;
		status = "okay";
	};

	cp1_sfp_eth1: sfp-eth-2 {
		compatible = "sff,sfp";
		i2c-bus = <&cp1_i2c0>;
		los-gpios = <&cp1_gpio1 11 GPIO_ACTIVE_HIGH>;
		mod-def0-gpios = <&cp1_gpio1 10 GPIO_ACTIVE_LOW>;
		tx-disable-gpios = <&cp1_gpio1 9 GPIO_ACTIVE_HIGH>;
		tx-fault-gpios = <&cp1_gpio1 8 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&cp1_sfp_pins>;
		/*
		 * SFP cages are unconnected on early PCBs because of an the I2C
		 * lanes not being connected. Prevent the port for being
		 * unusable by disabling the SFP node.
		 */
		status = "disabled";
	};

	// This is just a guess at what the pin does, but it seems this needs to
	// be enabled for the LEDs on the marvell switch to function as expected.
	led_regulator: led-regulator {
		compatible = "regulator-fixed";
		pinctrl-names = "default";
		pinctrl-0 = <&cp0_led_regulator_pin>;
		regulator-name = "led-regulator";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		gpio = <&cp0_gpio2 12 GPIO_ACTIVE_LOW>;
		regulator-always-on;
	};

	gpio-leds {
		compatible = "gpio-leds";

		led_system: system {
			label = "green:system";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&cp0_gpio2 30 GPIO_ACTIVE_LOW>;
			function = LED_FUNCTION_STATUS;
		};

		wan-led-amber {
			label = "amber:wan";
			color = <LED_COLOR_ID_AMBER>;
			gpios = <&cp1_gpio1 0 GPIO_ACTIVE_LOW>;
			function = LED_FUNCTION_WAN;
		};
		wan-led-green {
			label = "green:wan";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&cp1_gpio1 11 GPIO_ACTIVE_LOW>;
			function = LED_FUNCTION_WAN;
		};

		usb-storage-led {
			label = "USB_STORAGE_LED";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&cp0_gpio1 2 GPIO_ACTIVE_LOW>;
			default-state = "keep";
		};
		usb-lte-led {
			label = "USB_LTE_LED";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&cp1_gpio1 7 GPIO_ACTIVE_LOW>;
			default-state = "keep";
		};
		fan-normal-led {
			label = "FAN_NORMAL_LED";
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&cp1_gpio1 8 GPIO_ACTIVE_LOW>;
			default-state = "keep";
		};
		fan-error-led {
			label = "FAN_ERROR_LED";
			color = <LED_COLOR_ID_AMBER>;
			gpios = <&cp0_gpio1 10 GPIO_ACTIVE_LOW>;
			default-state = "keep";
		};
	};

	keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&cp0_button_pin>;

		reset {
			label = "Reset";
			linux,code = <KEY_RESTART>;
			gpios = <&cp0_gpio1 4 GPIO_ACTIVE_LOW>;
		};
	};

	fan: gpio-fan {
		compatible = "gpio-fan";
		pinctrl-names = "default";
		pinctrl-0 = <&cp0_fan_pins>;
		gpios = <&cp0_gpio2 23 GPIO_ACTIVE_LOW
			 &cp0_gpio2 22 GPIO_ACTIVE_LOW>;
		gpio-fan,speed-map = <0 0>, <0 1>, <3000 2>, <6000 3>;
		#cooling-cells = <2>;
	};
};

&ap_thermal_ic {
	polling-delay = <1000>; /* milliseconds */
	trips {
		ap_active: trip-active {
			temperature = <40000>; /* millicelsius */
			hysteresis = <4000>; /* millicelsius */
			type = "active";
		};
		ap_high: trip-high {
			temperature = <60000>; /* millicelsius */
			hysteresis = <4000>; /* millicelsius */
			type = "active";
		};
	};
	cooling-maps {
		active {
			trip = <&ap_active>;
			cooling-device = <&fan 2 2>;
		};
		high {
			trip = <&ap_high>;
			cooling-device = <&fan 3 3>;
		};
	};
};

/*
 * CP related configuration
 */
&cp0_ethernet {
	status = "okay";
};

/* LAN1-11 via mv88e6193 switch */
&cp0_eth0 {
	status = "okay";
	phy-mode = "10gbase-r";
	phys = <&cp0_comphy4 0>;
	phy = <&mvsw6193>;
	fixed-link {
		speed = <10000>;
		full-duplex;
	};
};

&cp0_i2c1 {
	status = "okay";
	clock-frequency = <100000>;

	/* SLM-1521-V2 - U3 */
	i2c-mux@72 { /* verify address - depends on dpr */
		compatible = "nxp,pca9544";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <0x72>;
		cp0_sfpp0_i2c: i2c@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;
		};

		i2c@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;
			/* U12 */
			cp0_module_expander1: pca9555@21 {
				compatible = "nxp,pca9555";
				pinctrl-names = "default";
				gpio-controller;
				#gpio-cells = <2>;
				reg = <0x21>;
			};

		};
	};
};

&cp0_mdio {
	status = "okay";

	mvsw6193: switch@0{
		compatible = "marvell,mv88e6190";
		status = "okay";
		reg = <0>;
		ptp-disable;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			swport0: port@0 {
				reg = <0x0>;
				label = "lan3";
				phy-mode = "1000base-x";
			};

			swport1: port@1 {
				reg = <0x1>;
				label = "lan4";
				phy-handle = <&swphy1>;

				leds {
					#address-cells = <1>;
					#size-cells = <0>;

					led@0 {
						reg = <0>;
						color = <LED_COLOR_ID_GREEN>;
						function = LED_FUNCTION_LAN;
					};

					led@1 {
						reg = <1>;
						color = <LED_COLOR_ID_AMBER>;
						function = LED_FUNCTION_LAN;
					};
				};
			};

			swport2: port@2 {
				reg = <0x2>;
				label = "lan5";
				phy-handle = <&swphy2>;

				leds {
					#address-cells = <1>;
					#size-cells = <0>;

					led@0 {
						reg = <0>;
						color = <LED_COLOR_ID_GREEN>;
						function = LED_FUNCTION_LAN;
					};

					led@1 {
						reg = <1>;
						color = <LED_COLOR_ID_AMBER>;
						function = LED_FUNCTION_LAN;
					};
				};
			};

			swport3: port@3 {
				reg = <0x3>;
				label = "lan6";
				phy-handle = <&swphy3>;

				leds {
					#address-cells = <1>;
					#size-cells = <0>;

					led@0 {
						reg = <0>;
						color = <LED_COLOR_ID_GREEN>;
						function = LED_FUNCTION_LAN;
					};

					led@1 {
						reg = <1>;
						color = <LED_COLOR_ID_AMBER>;
						function = LED_FUNCTION_LAN;
					};
				};
			};

			swport4: port@4 {
				reg = <0x4>;
				label = "lan7";
				phy-handle = <&swphy4>;

				leds {
					#address-cells = <1>;
					#size-cells = <0>;

					led@0 {
						reg = <0>;
						color = <LED_COLOR_ID_GREEN>;
						function = LED_FUNCTION_LAN;
					};

					led@1 {
						reg = <1>;
						color = <LED_COLOR_ID_AMBER>;
						function = LED_FUNCTION_LAN;
					};
				};
			};

			swport5: port@5 {
				reg = <0x5>;
				label = "lan8";
				phy-handle = <&swphy5>;

				leds {
					#address-cells = <1>;
					#size-cells = <0>;

					led@0 {
						reg = <0>;
						color = <LED_COLOR_ID_GREEN>;
						function = LED_FUNCTION_LAN;
					};

					led@1 {
						reg = <1>;
						color = <LED_COLOR_ID_AMBER>;
						function = LED_FUNCTION_LAN;
					};
				};
			};

			swport6: port@6 {
				reg = <0x6>;
				label = "lan9";
				phy-handle = <&swphy6>;

				leds {
					#address-cells = <1>;
					#size-cells = <0>;

					led@0 {
						reg = <0>;
						color = <LED_COLOR_ID_GREEN>;
						function = LED_FUNCTION_LAN;
					};

					led@1 {
						reg = <1>;
						color = <LED_COLOR_ID_AMBER>;
						function = LED_FUNCTION_LAN;
					};
				};
			};

			swport7: port@7 {
				reg = <0x7>;
				label = "lan10";
				phy-handle = <&swphy7>;

				leds {
					#address-cells = <1>;
					#size-cells = <0>;

					led@0 {
						reg = <0>;
						color = <LED_COLOR_ID_GREEN>;
						function = LED_FUNCTION_LAN;
					};

					led@1 {
						reg = <1>;
						color = <LED_COLOR_ID_AMBER>;
						function = LED_FUNCTION_LAN;
					};
				};
			};

			swport8: port@8 {
				reg = <0x8>;
				label = "lan11";
				phy-handle = <&swphy8>;

				leds {
					#address-cells = <1>;
					#size-cells = <0>;

					led@0 {
						reg = <0>;
						color = <LED_COLOR_ID_GREEN>;
						function = LED_FUNCTION_LAN;
					};

					led@1 {
						reg = <1>;
						color = <LED_COLOR_ID_AMBER>;
						function = LED_FUNCTION_LAN;
					};
				};
			};

			port@9 {
				reg = <0x9>;
				label = "cpu";
				ethernet = <&cp0_eth0>;
				phy-mode = "10gbase-r";

				fixed-link {
					speed = <10000>;
					full-duplex;
				};
			};

			port@a {
				reg = <0xa>;
				label = "lan2";
				phy-mode = "10gbase-r";
				managed = "in-band-status";
			};
		};

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			swphy1: switch-phy@1 {
				reg = <0x1>;
			};

			swphy2: switch-phy@2 {
				reg = <0x2>;
			};

			swphy3: switch-phy@3 {
				reg = <0x3>;
			};

			swphy4: switch-phy@4 {
				reg = <0x4>;
			};

			swphy5: switch-phy@5 {
				reg = <0x5>;
			};

			swphy6: switch-phy@6 {
				reg = <0x6>;
			};

			swphy7: switch-phy@7 {
				reg = <0x7>;
			};

			swphy8: switch-phy@8 {
				reg = <0x8>;
			};
		};
	};
};

/* U54 */
&cp0_nand_controller {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&nand_pins &nand_rb>;

	nand@0 {
		reg = <0>;
		label = "main-storage";
		nand-rb = <0>;
		nand-ecc-mode = "hw";
		nand-on-flash-bbt;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "firmware";
				compatible = "linux,ubi";
				reg = <0 0xfc00000>;
			};

			partition@fc00000 {
				label = "panic-oops";
				reg = <0xfc00000 0x400000>;
			};
		};
	};
};

&cp0_spi0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&cp0_spi0_pins>;
	reg = <0x700600 0x50>,		/* control */
	      <0x2000000 0x1000000>;	/* CS0 */

	spi-flash@0 {
		#address-cells = <0x1>;
		#size-cells = <0x1>;
		compatible = "jedec,spi-nor";
		reg = <0x0>;
		/* On-board MUX does not allow higher frequencies */
		spi-max-frequency = <40000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x0 0x200000>;
			};

			partition@200000 {
				label = "u-boot-backup";
				reg = <0x200000 0x1f0000>;
			};

			partition@3f0000 {
				label = "u-boot-env";
				reg = <0x3f0000 0x10000>;
			};
		};
	};
};

&cp0_syscon0 {
	cp0_pinctrl: pinctrl {
		compatible = "marvell,cp115-standalone-pinctrl";

		cp0_uart2_pins: cp0-uart-pins-0 {
			marvell,pins = "mpp37", "mpp38"; /* RX and TX MPP IDs for CP0 UART0 */
			marvell,function = "uart2"; /* UART0 function number */
		};

		cp0_i2c1_pins: cp0-i2c-pins-1 {
			marvell,pins = "mpp35", "mpp36";
			marvell,function = "i2c1";
		};
		cp0_spi0_pins: cp0-spi-pins-0 {
			marvell,pins = "mpp56", "mpp57", "mpp58", "mpp59";
			marvell,function = "spi0";
		};
		nand_pins: nand-pins {
			marvell,pins =
			"mpp15", "mpp16", "mpp17", "mpp18", "mpp19",
			"mpp20", "mpp21", "mpp22", "mpp23", "mpp24",
			"mpp25", "mpp26", "mpp27";
			marvell,function = "dev";
		};
		nand_rb: nand-rb {
			marvell,pins = "mpp13";
			marvell,function = "nf";
		};

		cp0_button_pin: cp0-button-pin {
			marvell,pins = "mpp4";
			marvell,function = "gpio";
		};

		cp0_led_regulator_pin: cp0-led-regulator-pin {
			marvell,pins = "mpp44";
			marvell,function = "gpio";
		};

		cp0_fan_pins: cp0-fan-pins {
			marvell,pins = "mpp54", "mpp55";
			marvell,function = "gpio";
		};
	};
};

// UART0 is the factory default console, which we don't really use.
// I *think* it goes to the 4-pin header beside the CPU, but I couldn't
// get any signs of life (might have had the wrong UART voltage, IDK)
&uart0 {
	status = "okay";
	pinctrl-0 = <&uart0_pins>;
	pinctrl-names = "default";
};

&cp0_uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&cp0_uart2_pins>;
	status = "okay";
};

&cp0_crypto {
	status = "okay";
};

&cp0_utmi {
	status = "okay";
};

&cp0_usb3_0 {
	status = "okay";
	usb-phy = <&cp0_usb3_0_phy0>;
	phys = <&cp0_utmi0>;
	phy-names = "utmi";
	dr_mode = "host";
};

&cp0_usb3_1 {
	status = "okay";
	usb-phy = <&cp0_usb3_0_phy1>;
	phys = <&cp0_utmi1>;
	phy-names = "utmi";
	dr_mode = "host";
};

/*
 * Instantiate the first slave CP115
 */

#define CP11X_NAME		cp1
#define CP11X_BASE		f4000000
#define CP11X_PCIEx_MEM_BASE(iface) (0xe2000000 + (iface * 0x1000000))
#define CP11X_PCIEx_MEM_SIZE(iface) 0xf00000
#define CP11X_PCIE0_BASE	f4600000
#define CP11X_PCIE1_BASE	f4620000
#define CP11X_PCIE2_BASE	f4640000

#include "armada-cp115.dtsi"

#undef CP11X_NAME
#undef CP11X_BASE
#undef CP11X_PCIEx_MEM_BASE
#undef CP11X_PCIEx_MEM_SIZE
#undef CP11X_PCIE0_BASE
#undef CP11X_PCIE1_BASE
#undef CP11X_PCIE2_BASE

&cp1_ethernet {
	status = "okay";
};

&cp1_crypto {
	status = "okay";
};

/* "WAN" SFP+ Port */
&cp1_eth0 {
	status = "okay";
	label = "wan";
	phy-mode = "10gbase-r";
	phys = <&cp1_comphy4 0>;
	managed = "in-band-status";
	sfp = <&cp1_sfp_eth0>;
};

&cp1_xmdio {
	status = "okay";
	phy8: ethernet-phy@8 {
		compatible = "ethernet-phy-ieee802.3-c45";
		reg = <8>;
	};
};


&cp1_crypto {
	status = "disabled";
};

&cp1_gpio1 {
	status = "okay";
};

&cp1_gpio2 {
	status = "okay";
};

&cp1_i2c0 {
	pinctrl-names = "default";
	pinctrl-0 = <&cp1_i2c0_pins>;
	status = "okay";
	clock-frequency = <100000>;
};

&cp1_i2c1 {
	pinctrl-names = "default";
	pinctrl-0 = <&cp1_i2c1_pins>;
	status = "okay";
	clock-frequency = <100000>;
};

&cp1_syscon0 {
	cp1_pinctrl: pinctrl {
		compatible = "marvell,cp115-standalone-pinctrl";

		cp1_i2c0_pins: cp1-i2c-pins-0 {
			marvell,pins = "mpp37", "mpp38";
			marvell,function = "i2c0";
		};
		cp1_i2c1_pins: cp1-i2c-pins-1 {
			marvell,pins = "mpp35", "mpp36";
			marvell,function = "i2c1";
		};
		cp1_xhci0_vbus_pins: cp1-xhci0-vbus-pins {
			marvell,pins = "mpp15", "mpp16";
			marvell,function = "gpio";
		};
		cp1_xhci1_vbus_pins: cp1-xhci1-vbus-pins {
			marvell,pins = "mpp13", "mpp14";
			marvell,function = "gpio";
		};
		cp1_sfp_pins: sfp-pins {
			marvell,pins = "mpp48", "mpp49", "mpp50";
			marvell,function = "gpio";
		};
	};
};
